{
  "openapi": "3.0.3",
  "info": {
    "title": "Dent App API",
    "version": "1.1.0",
    "description": "Current API contract for the Dent App backend. Covers authentication, user self-service, admin and teacher access, quiz CRUD, nested question CRUD, quiz results, and audit logs."
  },
  "servers": [
    {
      "url": "http://localhost:3555",
      "description": "Local development server"
    }
  ],
  "tags": [
    {
      "name": "Auth"
    },
    {
      "name": "Users"
    },
    {
      "name": "Quizzes"
    },
    {
      "name": "Questions"
    },
    {
      "name": "Audit"
    }
  ],
  "components": {
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "token"
      },
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ApiError": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "fail"
          },
          "message": {
            "type": "string"
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "role": {
            "type": "string",
            "enum": ["user", "teacher", "admin", "guest"]
          },
          "avatar": {
            "type": "string",
            "nullable": true
          },
          "provider": {
            "type": "string",
            "example": "local"
          },
          "testResults": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TestResult"
            }
          }
        },
        "required": ["_id", "name", "email", "role"]
      },
      "TestResult": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "quiz": {
            "type": "string"
          },
          "user": {
            "type": "string"
          },
          "points": {
            "type": "integer"
          },
          "totalQuestions": {
            "type": "integer"
          },
          "date": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": ["_id", "quiz", "user", "points", "totalQuestions"]
      },
      "Quiz": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "icon": {
            "type": "string",
            "nullable": true
          },
          "questions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Question"
            }
          }
        },
        "required": ["_id", "title", "description"]
      },
      "QuizInput": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 3
          },
          "description": {
            "type": "string",
            "minLength": 10
          },
          "icon": {
            "type": "string",
            "description": "May be an external URL, local path, data:image string, or blob URL."
          }
        },
        "required": ["title", "description"]
      },
      "Question": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "quiz": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "minItems": 2,
            "maxItems": 10,
            "items": {
              "type": "string"
            }
          },
          "answer": {
            "type": "integer",
            "description": "Zero-based index of the correct answer."
          },
          "image": {
            "type": "string",
            "nullable": true
          }
        },
        "required": ["_id", "quiz", "question", "options", "answer"]
      },
      "QuestionInput": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string",
            "minLength": 5
          },
          "options": {
            "type": "array",
            "minItems": 2,
            "maxItems": 10,
            "items": {
              "type": "string"
            }
          },
          "answer": {
            "type": "integer"
          },
          "image": {
            "type": "string"
          }
        },
        "required": ["question", "options", "answer"]
      },
      "QuizResultInput": {
        "type": "object",
        "properties": {
          "points": {
            "type": "integer",
            "minimum": 0
          },
          "totalQuestions": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": ["points", "totalQuestions"]
      },
      "AdminCreateUserInput": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 8
          },
          "passwordConfirm": {
            "type": "string",
            "minLength": 8
          },
          "role": {
            "type": "string",
            "enum": ["user", "teacher", "admin", "guest"]
          }
        },
        "required": ["name", "email", "password", "passwordConfirm"]
      },
      "AdminUpdateUserInput": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "role": {
            "type": "string",
            "enum": ["user", "teacher", "admin", "guest"]
          },
          "avatar": {
            "type": "string"
          }
        }
      },
      "AuditLog": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "actor": {
            "description": "Populated user reference when available",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/components/schemas/User"
              }
            ]
          },
          "actorRole": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "example": "quiz.update"
          },
          "entityType": {
            "type": "string",
            "example": "quiz"
          },
          "entityId": {
            "type": "string"
          },
          "details": {
            "type": "object",
            "additionalProperties": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  },
  "paths": {
    "/": {
      "get": {
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "Backend is running"
          }
        }
      }
    },
    "/api/v1/auth/signup": {
      "post": {
        "tags": ["Auth"],
        "summary": "Register a local user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminCreateUserInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created"
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Log in with email and password",
        "responses": {
          "200": {
            "description": "Authenticated"
          }
        }
      }
    },
    "/api/v1/auth/forgotPassword": {
      "post": {
        "tags": ["Auth"],
        "summary": "Request password reset email",
        "responses": {
          "200": {
            "description": "Reset email requested"
          }
        }
      }
    },
    "/api/v1/auth/resetPassword/{token}": {
      "post": {
        "tags": ["Auth"],
        "summary": "Reset password using token",
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Password reset"
          }
        }
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "tags": ["Auth"],
        "summary": "Refresh auth tokens",
        "responses": {
          "200": {
            "description": "Tokens refreshed"
          }
        }
      }
    },
    "/api/v1/auth/google": {
      "get": {
        "tags": ["Auth"],
        "summary": "Start Google OAuth flow",
        "responses": {
          "302": {
            "description": "Redirect to Google"
          }
        }
      }
    },
    "/api/v1/auth/google/callback": {
      "get": {
        "tags": ["Auth"],
        "summary": "Google OAuth callback",
        "responses": {
          "302": {
            "description": "Redirect after successful OAuth"
          }
        }
      }
    },
    "/api/v1/users/logout": {
      "post": {
        "tags": ["Users"],
        "summary": "Log out current session",
        "responses": {
          "200": {
            "description": "Logged out"
          }
        }
      }
    },
    "/api/v1/users/refresh": {
      "post": {
        "tags": ["Users"],
        "summary": "Refresh user tokens from users namespace",
        "responses": {
          "200": {
            "description": "Tokens refreshed"
          }
        }
      }
    },
    "/api/v1/users/me": {
      "get": {
        "tags": ["Users"],
        "summary": "Get current authenticated user",
        "security": [
          { "cookieAuth": [] },
          { "bearerAuth": [] }
        ],
        "responses": {
          "200": {
            "description": "Current user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users/updateMe": {
      "patch": {
        "tags": ["Users"],
        "summary": "Update own profile",
        "security": [
          { "cookieAuth": [] },
          { "bearerAuth": [] }
        ],
        "responses": {
          "200": {
            "description": "Profile updated"
          }
        }
      }
    },
    "/api/v1/users/updatePassword": {
      "patch": {
        "tags": ["Users"],
        "summary": "Update own password",
        "security": [
          { "cookieAuth": [] },
          { "bearerAuth": [] }
        ],
        "responses": {
          "200": {
            "description": "Password updated"
          }
        }
      }
    },
    "/api/v1/users/deleteMe": {
      "delete": {
        "tags": ["Users"],
        "summary": "Deactivate own account",
        "security": [
          { "cookieAuth": [] },
          { "bearerAuth": [] }
        ],
        "responses": {
          "204": {
            "description": "Account deactivated"
          }
        }
      }
    },
    "/api/v1/users": {
      "get": {
        "tags": ["Users"],
        "summary": "List users",
        "description": "Accessible to admin and teacher roles.",
        "security": [
          { "cookieAuth": [] },
          { "bearerAuth": [] }
        ],
        "responses": {
          "200": {
            "description": "Users returned"
          }
        }
      },
      "post": {
        "tags": ["Users"],
        "summary": "Create user",
        "description": "Admin only.",
        "security": [
          { "cookieAuth": [] },
          { "bearerAuth": [] }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminCreateUserInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created"
          }
        }
      }
    },
    "/api/v1/users/{id}": {
      "get": {
        "tags": ["Users"],
        "summary": "Get user by id",
        "description": "Accessible to admin and teacher roles.",
        "security": [
          { "cookieAuth": [] },
          { "bearerAuth": [] }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User returned"
          }
        }
      },
      "patch": {
        "tags": ["Users"],
        "summary": "Update user by id",
        "description": "Admin only.",
        "security": [
          { "cookieAuth": [] },
          { "bearerAuth": [] }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminUpdateUserInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User updated"
          }
        }
      },
      "delete": {
        "tags": ["Users"],
        "summary": "Delete user by id",
        "description": "Admin only.",
        "security": [
          { "cookieAuth": [] },
          { "bearerAuth": [] }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "User deleted"
          }
        }
      }
    },
    "/api/v1/users/audit-logs": {
      "get": {
        "tags": ["Audit"],
        "summary": "Get recent audit logs",
        "description": "Admin only.",
        "security": [
          { "cookieAuth": [] },
          { "bearerAuth": [] }
        ],
        "responses": {
          "200": {
            "description": "Audit logs returned",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AuditLog"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/quizzes": {
      "get": {
        "tags": ["Quizzes"],
        "summary": "List quizzes",
        "responses": {
          "200": {
            "description": "Quiz list returned"
          }
        }
      },
      "post": {
        "tags": ["Quizzes"],
        "summary": "Create quiz",
        "description": "Admin only.",
        "security": [
          { "cookieAuth": [] },
          { "bearerAuth": [] }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuizInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Quiz created"
          }
        }
      }
    },
    "/api/v1/quizzes/{id}": {
      "get": {
        "tags": ["Quizzes"],
        "summary": "Get quiz by id",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Quiz returned"
          }
        }
      },
      "patch": {
        "tags": ["Quizzes"],
        "summary": "Update quiz",
        "description": "Admin only.",
        "security": [
          { "cookieAuth": [] },
          { "bearerAuth": [] }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuizInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Quiz updated"
          }
        }
      },
      "delete": {
        "tags": ["Quizzes"],
        "summary": "Delete quiz",
        "description": "Admin only.",
        "security": [
          { "cookieAuth": [] },
          { "bearerAuth": [] }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Quiz deleted"
          }
        }
      }
    },
    "/api/v1/quizzes/{id}/results": {
      "post": {
        "tags": ["Quizzes"],
        "summary": "Save quiz result",
        "description": "Requires authentication. Standard users can save one result per quiz. Teachers and admins may overwrite their previous result.",
        "security": [
          { "cookieAuth": [] },
          { "bearerAuth": [] }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuizResultInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Result created"
          },
          "200": {
            "description": "Result overwritten for privileged role"
          }
        }
      }
    },
    "/api/v1/quizzes/{id}/questions": {
      "get": {
        "tags": ["Questions"],
        "summary": "List questions for a quiz",
        "security": [
          { "cookieAuth": [] },
          { "bearerAuth": [] }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Questions returned"
          }
        }
      },
      "post": {
        "tags": ["Questions"],
        "summary": "Create question for a quiz",
        "description": "Admin only.",
        "security": [
          { "cookieAuth": [] },
          { "bearerAuth": [] }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuestionInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Question created"
          }
        }
      }
    },
    "/api/v1/quizzes/{id}/questions/{questionId}": {
      "get": {
        "tags": ["Questions"],
        "summary": "Get question by id within quiz",
        "security": [
          { "cookieAuth": [] },
          { "bearerAuth": [] }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "questionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Question returned"
          }
        }
      },
      "patch": {
        "tags": ["Questions"],
        "summary": "Update question",
        "description": "Admin only.",
        "security": [
          { "cookieAuth": [] },
          { "bearerAuth": [] }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "questionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuestionInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Question updated"
          }
        }
      },
      "delete": {
        "tags": ["Questions"],
        "summary": "Delete question",
        "description": "Admin only.",
        "security": [
          { "cookieAuth": [] },
          { "bearerAuth": [] }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "questionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Question deleted"
          }
        }
      }
    }
  }
}
